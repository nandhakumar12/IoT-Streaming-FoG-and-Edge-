# ─────────────────────────────────────────────
# EdgeGuardian – Environment Configuration
# EdgeStream Edition: MQTT + Kafka + Redis + Anomaly AI
# ─────────────────────────────────────────────

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Sensor Simulator
PUBLISH_RATE=1.0           # messages per second per sensor
SENSORS=temperature,vibration,humidity,pressure,power_consumption

# Fog Node
AGGREGATION_WINDOW_MS=10000  # 10-second tumbling window
METRICS_PORT=3001
FOG_ANOMALY_THRESHOLD=0.20   # 20% anomaly rate triggers adaptive sampling

# Anomaly Detection Service (Phase 2 — Edge AI)
ANOMALY_SERVICE_HOST=localhost
ANOMALY_SERVICE_PORT=5001
ANOMALY_THRESHOLD=-0.1       # Isolation Forest score threshold

# Kafka (Phase 3 — Distributed Stream Processing)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=fog.readings

# Redis Cache (Phase 4 — Caching Layer)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloud / Backend
CLOUD_MODE=kafka             # local | kafka | aws
CLOUD_ENDPOINT=http://localhost:3000
CLOUD_API_KEY=local-dev-key

# AWS (only needed when CLOUD_MODE=aws)
AWS_REGION=eu-west-1
AWS_API_GATEWAY_URL=https://REPLACE.execute-api.eu-west-1.amazonaws.com/prod
AWS_API_KEY=REPLACE_WITH_YOUR_API_KEY

# Dashboard
VITE_API_URL=http://localhost:3000
VITE_FOG_METRICS_URL=http://localhost:3001
VITE_POLL_INTERVAL_MS=2000
